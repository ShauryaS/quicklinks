{
  "name": "quicklinks",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker-dev": "docker-compose up -d dev",
    "docker-prod": "docker-compose up -d prod",
    "docker-stop": "docker-compose stop dev prod",
    "docker-reset": "docker-compose down --rmi all -v"
  },
  "dependencies": {
    "framer-motion": "^10.6.0",
    "next": "^12.1.6",
    "polished": "^4.2.2",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "react-inlinesvg": "^3.0.0",
    "sharp": "^0.30.4",
    "styled-components": "^5.3.5"
  },
  "devDependencies": {
    "babel-plugin-styled-components": "^2.0.7",
    "eslint": "8.15.0",
    "eslint-config-next": "12.1.6",
    "prettier": "2.6.2"
  },
  "babel": {
    "env": {
      "development": {
        "presets": [
          "next/babel"
        ],
        "plugins": [
          [
            "babel-plugin-styled-components",
            {
              "ssr": true,
              "displayName": true,
              "preprocess": false
            }
          ]
        ]
      },
      "production": {
        "presets": [
          "next/babel"
        ],
        "plugins": [
          [
            "babel-plugin-styled-components",
            {
              "ssr": true,
              "displayName": false,
              "preprocess": false
            }
          ]
        ]
      }
    }
  }
}
